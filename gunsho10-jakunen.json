 ],
 "poems": [
  {
   "seq": "1",
   "text": "谷の水峯のあらしもゝろともに春立けふといかてゑるらむ",
   "kana": "",
   "speaker": "〔舊本行書躰〕",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "2",
   "text": "ちれはおしにほひはまさる梅の花いかにかすへき春の山かせ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "3",
   "text": "春雨も日をへてふりぬみよしのゝ吉野の山に花やさくらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "4",
   "text": "よしの山花咲ぬれはあちきなくこゝろにかゝる峯のふら雲",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "5",
   "text": "山さくら咲るたかれのゑら雲はいつれか花の梢なるらむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "6",
   "text": "この春そ思ひはかへす櫻はなむなしき色にそめしこゝろを",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "7",
   "text": "木のもとは花ゆへにやはすみそめしちれは心のあくかれぬ覽",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "8",
   "text": "花盛いさ木のもとにくらしてむさかすはなにのみにか成へき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "9",
   "text": "おしめとも風にみたれて散はなをむすひとゝめよ靑柳のいと",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "10",
   "text": "むら鳥のわかれやおしき花のちる梢にきつゝうくひすのなく",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "11",
   "text": "山櫻ちる木のもとはたちうくてやすむとなしに日を暮しつゝ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "12",
   "text": "谷河の春のなかれをむすふにはたよりうれしき花を社くめ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "13",
   "text": "あさみとり霞にきゆる鴈かねのこゝろほそきは春の明ほの",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "14",
   "text": "つく〓〓と春の日くらし降雨は月みる秋のこゝろこそすれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "15",
   "text": "小山田のたねまくよりそ哀なるいなはのかせをかれて思へは",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "16",
   "text": "春雨のまたれめ色もかはらねはちしほにみゆる山ふきの花",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "17",
   "text": "をそさくらまた散やらぬ花やあると外山ふみ分とふ人もかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "18",
   "text": "入ぬるかおほつかなしや山のはにかすみかゝれる春の夜の月",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "19",
   "text": "このもとは花よりほかの友もなしたれをみをきて春の行らむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "20",
   "text": "ゆく春のかたみはかりに殘しける花のかけにてけふは暮さん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "21",
   "text": "をしみつる花にかへたる時鳥鳴音を待もくるしかりけり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "22",
   "text": "すむ人の心そみゆるうの花をひとへにかこふをのゝ山さと",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "23",
   "text": "ゆふかけて片岡になく時鳥かものみあれになのりすらしも",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "24",
   "text": "卯花にほとゝきす鳴かた山のかきねにいかでみをかくしけむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "25",
   "text": "あやめ草さ月もふらぬ山さとの軒のしのふをよそへてそみる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "26",
   "text": "たつぬとてやとにとゝまるよしもなし山時鳥いもやいさめん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "27",
   "text": "たつれつゝ生田の杜のほとゝきす蘆のしのやの忍ひねになく",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "28",
   "text": "あちきなくまたしと思へと郭公あかぬ名殘もときは成けり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "29",
   "text": "まつといひあかすとなけくとにかくになにのむくひそ山時鳥",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "30",
   "text": "きゝもあへす淚こほれぬほとゝきす老のね覺の曉のこゑ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "31",
   "text": "いくかへり聞てかあくとこゝろみようちはへてなく山時鳥",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "32",
   "text": "こゝろ社聲にをとらぬほとゝきす更行空にひとりやすらふ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "33",
   "text": "松かけの岩ねにしける苔むしろなつもかよはぬすみかなり鳬",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "34",
   "text": "ひくらしのなく片山のならのはにかせうちそよく夏の夕くれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "35",
   "text": "秋はきぬとしもなかはにすきぬとや荻吹風のおとろかすらむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "36",
   "text": "あさちはらぬしなき宿の荻のはにたれにか風の秋をつくらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "37",
   "text": "秋風にうつらなく野を來てみれはうへにし萩のまかき也けり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "38",
   "text": "あるしなきまかきはあれてをのれのみ秋をわすれぬ女郞花哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "39",
   "text": "みにことも誰にかいはむ小萩咲まかきをたゝにすくさすも哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "40",
   "text": "かれてより心はすみぬ秋のよの月まつみねのこからしのかせ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "41",
   "text": "里はあれて月はすみます秋の夜を哀といふもなへてなる哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "42",
   "text": "過きにし昔をさらにさそひきて心にやとす秋のよの月",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "43",
   "text": "月をみて哀ゑるらむやとことにみを分て社とはまほしけれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "44",
   "text": "里わかぬものにしあれは秋のよの月の心をはちつゝそみる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "45",
   "text": "わすれつゝひるかとおもふ秋のよの月とは虫の聲ぞふらする",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "46",
   "text": "月影を袖に移してみるのみやものおもふ人のとりところなる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "47",
   "text": "おもふことなくてなかめは中〓〓に月の哀やなへてならまし",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "48",
   "text": "心すむちゝの哀をあつめてや秋の月をはみかきいつらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "49",
   "text": "この世には心とゝめし秋の月すこしはやつすくもゝあらなむ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "50",
   "text": "露ふるき蓬かもとをかきわけて月はみるやととふ人もなし",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "51",
   "text": "いかならん雲ゐなりともおくれしと月のみ獨り契りおきける",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "52",
   "text": "蓬生に成行やとはきり〓〓す鳴れを床のものと社きけ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "53",
   "text": "ちりつもる紅葉分きてよそにみは哀なるへき庭のおも哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "54",
   "text": "はかなくてくれ行秋のかなしさをおもひゑらする鹿のこゑ哉",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "55",
   "text": "をとせぬに冬のけしきの志るき哉こほりにけりな谷のした水",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "56",
   "text": "月は猶おなしそらをもなかめけり野へのけしきそ秋は淋しき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "57",
   "text": "かきくらし物そ悲しき神無月なかむる空もうち時雨つゝ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "58",
   "text": "山めくり染をく色とみし程にはては木の葉も時雨とそふる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "59",
   "text": "霜枯のよもきか庭のさひしきに菊のみ秋の名殘なるかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "60",
   "text": "もみち葉のちるを歎し梢より月のもるこそうれしかりけれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "61",
   "text": "たれか又まきの板やにねさめしてふくれの音に袖ぬらすらん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "62",
   "text": "色めきし花のかつらに女郞花いたゝく霜のあはれなるかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "63",
   "text": "花にのみ心はあれやきゝすなく枯野のすゝきみる人もなし",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "64",
   "text": "みよしのゝ山へに雪のつもるにはまつふる里そ冬こもりける",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "65",
   "text": "たつねきてみち分わふる人もあらしいくへもつもれ庭の自雪",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "66",
   "text": "花さかぬ梢はみえすおほかたは雪のうちをそ春といふへき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "67",
   "text": "おきつかせ身にや忘むらんから衣うきゝの浦に千鳥鳴なり",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "68",
   "text": "霜さゆる蘆のしのやにね覺してひまやゑらむと待たぬよそなき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "69",
   "text": "行年をゝくりむかふといふ程にさためなきよのはてそ悲しき",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "70",
   "text": "ますかゝみみし俤の身にそひて心は君にうつりぬるかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "71",
   "text": "袖にみつなみたの玉をぬきためて戀しきかすを君にみせはや",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "72",
   "text": "戀しさのつらさにまくる物ならは今まてかくは歎かさらまし",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "73",
   "text": "君ゆへにおつる淚のおしけれはかたしく釉をほしそわひぬる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "74",
   "text": "うたゝねの夢にも人のつらけれは驚く程にぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "75",
   "text": "かく計り人の心をくたきけむむくひおもふもうらめしのみや",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "76",
   "text": "うらみかね思へはつらしよの中に戀といふ事を誰はしめけん",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "77",
   "text": "つらきをは思ふあまりに忘られぬ戀しき事のなくさめもかな",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "78",
   "text": "明ぬとて常は厭ひし鳥の音のひとりしぬれはまたれかほなる",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "79",
   "text": "かへるさの袂にかゝる涙こそうらみしよりも色增りけれ",
   "kana": "",
   "speaker": "",
   "page": 43,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "80",
   "text": "花見にときくに心のたくふかなすかたは苔にやつれはつれと",
   "kana": "",
   "speaker": "寂然法師集",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "81",
   "text": "きく人のころもに玉もかゝるまて涙こほれし法のにはかな",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "82",
   "text": "朝日待かすに入身そたのもしきいつへきほとは遙なれとも",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "83",
   "text": "天のはらへたてぬ月を志るへにてもろこしまてもゆく心哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "84",
   "text": "雲ゐにてむかしなかめし月のみや旅の空にもはなれさるらん",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "85",
   "text": "みたれすとおはりきく社嬉しけれさても別はなくさまねとも",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "86",
   "text": "入さにはひろふかたみものこりけりかへぬ山路のともは淚か",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "87",
   "text": "ふけきのとなれる住家をかき分てふかとはむとは思はさり見",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "88",
   "text": "濵千島はかなきあとをとゝめすは涙のかゝるたまもみましや",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "89",
   "text": "松風の音はいつことわかねともなをすみよしの秋そことなる",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "90",
   "text": "これそこの涙にくれしけふりよりわかちいてたる山のはの月",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "91",
   "text": "墨染の袂そけふは露ふかきつるのはやしのあとのみなしこ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "92",
   "text": "心有てみるとしもなきなには江の春の景色はおしくもある哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "93",
   "text": "みにかふるひとも有けることのはに心かゝらめすゑの露かな",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "94",
   "text": "ときはなるつるのはやしのあやなくも薪つきぬと思ひける哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "95",
   "text": "なみち分むなしき舟に見し月の名殘にこよひ袖ぬらしつゝ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "96",
   "text": "いつくにか我身すまゝしかく計うきよに山のおくなかりせは",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "97",
   "text": "あさかほの花に宿れる露のよははかなきうへに猶そはかなき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "98",
   "text": "みし人もかくれのみ行あた雲にいつたくふへき月日成らん",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "99",
   "text": "出しより家の風をもわすられて散らすはかりの〓との葉そなき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "100",
   "text": "世中をつねなきものと思はすはいかてか花の散にたへまし",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "101",
   "text": "陸奥のふのふもちすり忍ひつゝ色には出しみたれもそする",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "102",
   "text": "烟にも志はしたなひけとりへ山たち別にしかたみともみん",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "103",
   "text": "たちはなれ小萩か原に鳴鹿はみちふみまよふともや戀しき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "104",
   "text": "何事をまつとにてかすくさまし浮世をそむくみちなかりせは",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "105",
   "text": "稻つまの光のほとか秋のたのなひく末葉の露のいのちは",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "106",
   "text": "いかゝせむあとの哀はとはすとも別れし人の行衞たつねよ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "107",
   "text": "なき人を忍ふ思のなくさめはあとをもちたひとはれこそせめ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "108",
   "text": "待えたる雲あの月もやさられはおほろの〓水すむかひそなき",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "109",
   "text": "かつまたの池の心はむなしくて氷も水もなのみ成けり",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "110",
   "text": "くまもなき月の光にいさなひてわしのみ山なさして來にけり",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "111",
   "text": "さきの世の報ひときけは身のうさに思ひうるへき心地社せね",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "112",
   "text": "なにとなく涙の玉やこほれけお峯のこのみをひろふ袂に",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "113",
   "text": "身の爲とおもひて出ぬみちなれや心は人をそむきやはする",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "114",
   "text": "みちのへの螢はかりを点るへにてひとりそいつる夕やみの空",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "115",
   "text": "をさゝ原あるかなきいの一ふしにもとも末はもかはらさり鳬",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "116",
   "text": "つく〓〓むむしき空をなかめつゝ入相の鐘にぬるゝ袖かな",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "117",
   "text": "なにめてゝ秋のなかはゝこよひそと思ひかほなる月の影哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "118",
   "text": "なきかよをいかに哀とてらすらんむなしき空にすめる月影",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "119",
   "text": "もかみ河人をくたせはいな舟のかへりて沈むものとこそきけ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "120",
   "text": "木からしに月すむ峯の鹿の音をわれのみきくは惜くも有哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "121",
   "text": "慰にみつゝもゆかむ君かすむそなたの山を雲なへたてそ",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "122",
   "text": "歸るとも後にもまたと賴むへきこのみのうたてあたにも有哉",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "123",
   "text": "つく〓〓とことそともなき詠して今宵の月もかたふきに鳬",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "124",
   "text": "はかなさはけふともしらぬ世中にさりとものみはいつを待覽",
   "kana": "",
   "speaker": "よみ人しらず",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "125",
   "text": "おもひ入心とならはいたつらにあたしこのよをすくさゝら南",
   "kana": "",
   "speaker": "",
   "page": 44,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "126",
   "text": "雲はれてむなしき空にすみなからうき世中をめくる月哉",
   "kana": "",
   "speaker": "寂蓮法師集",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "127",
   "text": "吹風にはな立花やにほふらんむかしおほゆるけふのには哉",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "128",
   "text": "やみふかき木のもとことに契り置て朝たつ霧のあとの露けさ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "129",
   "text": "けふ過ぬ命もふかとおとろかす入相の鐘のこゑそかなしき",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "130",
   "text": "そむかすは何れのよにか巡りあひて思ひ見とも人にしられん",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "131",
   "text": "をとにきく君かりいつかいきの松まつらむものを心つくしに",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "132",
   "text": "わかれにしそのおもかけの戀しきに夢にもみえぬ山のはの月",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "133",
   "text": "わたつ海のふかきに沈むいさりせてたもつかひある法を求よ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "134",
   "text": "うき草の一葉なりとも磯かくれ思ひなかけそおきつしら浪",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "135",
   "text": "さなきたにおもさかうへのきよ衣我妻ならわつまないされそ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "136",
   "text": "花のもと露のなさけはほともあらし醉なすゝめそ春の山かせ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "137",
   "text": "ことしけき世をのかれにしみ山へに嵐のかせも心してふけ",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
   "form": "短歌",
   "genre": ""
  },
  {
   "seq": "138",
   "text": "とへかしなわかれの庭に露ふかき蓬かもとのこゝろほそさを",
   "kana": "",
   "speaker": "",
   "page": 45,
   "pid": "1879527",
